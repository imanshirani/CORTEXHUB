<?xml version="1.0" encoding="UTF-8"?>
<shelfDocument>
  <toolshelf name="cortex_shelf_tab" label="Cortex Pipeline">
    <memberTool name="cortex_open_latest"/>
    <memberTool name="cortex_save"/>
    <memberTool name="cortex_publish"/>
    <memberTool name="cortex_lookdev"/>
