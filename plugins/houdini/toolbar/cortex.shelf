  </toolshelf>

  <tool name="cortex_save" label="Save +" icon="BUTTONS_save">
    <script scriptType="python"><![CDATA[
import save_view
import importlib
importlib.reload(save_view)
save_view.run()
]]></script>
  </tool>

  <tool name="cortex_loader" label="Loader" icon="BUTTONS_list">
    <script scriptType="python"><![CDATA[
import loader
import importlib
importlib.reload(loader)
loader.run()
]]></script>
  </tool>

  <tool name="cortex_open_latest" label="Open Latest" icon="BUTTONS_revert">
    <script scriptType="python"><![CDATA[
import open_latest
import importlib
importlib.reload(open_latest)
open_latest.run()
]]></script>
  </tool>

  <tool name="cortex_lookdev" label="Lookdev Pub" icon="ROP_mantra">
    <script scriptType="python"><![CDATA[
import publisher_mat_houdini
import importlib
importlib.reload(publisher_mat_houdini)
publisher_mat_houdini.run_lookdev_publish()
]]></script>
  </tool>

  <tool name="cortex_publish" label="Publish" icon="PLASMA_App">
    <script scriptType="python"><![CDATA[
